PORT=3000
CURELAB_MODE=live
# Set live only after configuring BOTH providers. No API calls in demo mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Local transport/storage are enabled by default; sponsor services are not impersonated.

CURELAB_RUNTIME=freestyle
FREESTYLE_API_KEY=

# Official Agent Relay broker. Use local for offline tests/demos only.
CURELAB_TRANSPORT=agent-relay
RELAY_BROKER_URL=
RELAY_BROKER_API_KEY=

# Voice: OpenAI synthesis for both scientists; reviewed human transcription.
# Speech API compatibility model retires Jan 6, 2027; see README migration note.
CURELAB_VOICE=true
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_SCIENTIST_VOICE=nova
GROQ_SCIENTIST_VOICE=onyx
